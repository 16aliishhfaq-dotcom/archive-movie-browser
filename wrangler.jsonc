// Cloudflare Worker: static app + Neon Postgres backend + Upstash Redis.
// Set DATABASE_URL, ADMIN_PASSWORD, ADMIN_SESSION_SECRET, UPSTASH_REDIS_REST_URL,
// UPSTASH_REDIS_REST_TOKEN and UPSTASH_REDIS_REST_READ_ONLY_TOKEN with wrangler secret put.
// Legacy KV_REST_API_* Redis environment names remain supported for analytics.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "archive-movie-browser",
  "main": "worker.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sitemap.xml", "/c/*", "/u/*"]
  },
  "observability": { "enabled": true }
}
