# TMDB API Key - Get yours at https://www.themoviedb.org/settings/api
# Read by /api/tmdb on the server (the browser never sees it)
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# Runtime secrets: configure these on the Cloudflare Worker, not in VITE_* variables.
# DATABASE_URL=postgresql://... (Neon pooled connection string)
# ADMIN_PASSWORD=...
# ADMIN_SESSION_SECRET=...
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_REDIS_REST_READ_ONLY_TOKEN=... (optional)
# Legacy stats keys remain supported: KV_REST_API_URL, KV_REST_API_TOKEN,
# KV_REST_API_READ_ONLY_TOKEN, STATS_TOKEN and NET_SALT.

# Only for npm run index (building public/poster-index.json). Do not prefix with VITE_.
# TMDB_API_KEY=your_tmdb_api_key_here
# OPEN_ROUTER_API_KEY=your_openrouter_key_here
